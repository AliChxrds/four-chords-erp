# Copy to backend/.env and replace the local database placeholders.
# Variables already set in the environment take precedence over this file.

# development, test or production
NODE_ENV=development
PORT=5000

# Required database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=four_chords_erp
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_local_password

# Optional database tuning (defaults shown)
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000

# Comma-separated browser origins allowed to call the API, e.g. the ERP frontend.
# Empty allows no browser origins; server-to-server calls are unaffected.
CORS_ORIGINS=http://localhost:5173

# debug, info, warn, error or silent
LOG_LEVEL=info

# Set when running behind a reverse proxy or load balancer: true, a hop count such as 1,
# or trusted addresses. Leave false when the API is reached directly.
TRUST_PROXY=false

# Requests allowed per client IP to /api in each window (defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
